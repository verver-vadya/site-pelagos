---
interface Props { name?:string; class?:string; }
const { name='arrow', class:className='' } = Astro.props;
---
<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name==='arrow' && <path d="M5 12h14m-6-6 6 6-6 6"/>}
  {name==='down' && <path d="M12 4v16m-6-6 6 6 6-6"/>}
  {name==='plus' && <path d="M12 5v14M5 12h14"/>}
  {name==='close' && <path d="m6 6 12 12M18 6 6 18"/>}
  {name==='window' && <><path d="M4 20V11a8 8 0 0 1 16 0v9Z"/><path d="M4 14c4-5 9 5 16-1M4 18c5-4 10 4 16-1"/></>}
</svg>
