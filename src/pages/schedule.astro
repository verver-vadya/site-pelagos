---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import {events,zones} from '../data/ocean';
---
<Shell title="Программа" active="schedule">
<header class="page-intro"><p class="eyebrow">ПРОГРАММА / ВСТРЕЧИ И НАБЛЮДЕНИЯ</p><h1>Останьтесь<br/>ещё на историю.</h1><p class="lead">Выберите день и добавьте интересные встречи в свой план. Иногда один рассказ помогает увидеть за знакомым силуэтом целый мир.</p></header>
<section class="subsection" aria-label="Демонстрационная программа"><div class="schedule-toolbar"><label class="form-field">День посещения<input type="date" data-visit-date required/></label><p class="concept-line">Демонстрационная программа концепта. Она не является расписанием действующего океанариума.</p></div>{events.map(event=><article class="table-row"><time>{event.time}</time><div><h3>{event.title}</h3><p>{event.description}</p><p class="event-meta">{zones.find(zone=>zone.id===event.zone)?.name} · {event.duration}</p></div><button data-event={event.id} aria-pressed="false"><span data-event-label>В мой план</span><Icon name="plus"/></button></article>)}<p class="status" data-event-status aria-live="polite"></p></section>
</Shell>
