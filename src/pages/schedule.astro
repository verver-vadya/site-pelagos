---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import {events,zones} from '../data/ocean';
---
<Shell title="Программа" active="schedule">
<header class="page-intro"><p class="eyebrow">Программа</p><h1>Рассказы и кормления по часам</h1><p class="lead">Короткие встречи у аквариумов, от десяти до двадцати пяти минут. Добавьте нужные в план визита, и время будет под рукой.</p></header>
<section class="subsection" aria-label="Демонстрационная программа"><div class="schedule-toolbar"><label class="form-field">День посещения<input type="date" data-visit-date required/></label><p class="concept-line">Демонстрационная программа концепта. Она не является расписанием действующего океанариума.</p></div>{events.map(event=><article class="table-row"><time>{event.time}</time><div><h2>{event.title}{event.feeding&&<span class="feeding-mark">кормление</span>}</h2><p>{event.description}</p><p class="event-meta">{zones.find(zone=>zone.id===event.zone)?.name} · {event.duration}</p></div><button data-event={event.id} aria-pressed="false"><span data-event-label>В мой план</span><Icon name="plus"/></button></article>)}<p class="status" data-event-status aria-live="polite"></p></section>
</Shell>
