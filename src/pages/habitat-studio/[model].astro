---
import HabitatStudio from '../../components/HabitatStudio';
import {modelNames} from '../../lib/models';
import '../../styles/global.css';
// Local tool: renders each atlas animal in the home scene's water for its card image (scripts/render-species.cjs).
export function getStaticPaths(){return import.meta.env.DEV?modelNames.map(model=>({params:{model}})):[];}
const{model}=Astro.params;
---
<!doctype html><html lang="ru"><head><meta charset="utf-8"/><meta name="robots" content="noindex,nofollow"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Обитатель в воде — {model}</title></head><body><HabitatStudio model={model!} client:only="react"/></body></html>
<style is:global>body{height:100vh;overflow:hidden;background:#04172d}astro-dev-toolbar{display:none}</style>
