---
import Shell from '../layouts/Shell.astro';
import DescentScene from '../components/DescentScene';
import Icon from '../components/Icon.astro';
import {species} from '../data/ocean';
import {url} from '../lib/paths';
import '../styles/scene.css';
const named=(...slugs:string[])=>slugs.map(slug=>species.find(animal=>animal.slug===slug)!);
const chapters=[
 {range:'0–200 м · освещённая зона',title:'Здесь солнца хватает на всех',text:'В верхнем слое светло и тепло. Стаи сардин кормятся планктоном, за ними охотятся лакедры, манты собирают корм у самой поверхности, а медузы дрейфуют вместе с течением.',animals:named('sardine','kingfish','manta','jelly')},
 {range:'200–1000 м · сумеречная зона',title:'Солнце сюда почти не доходит',text:'Свет тускнеет до серо-синего, водорослей уже нет. Сюда ныряют за едой крупные пловцы: голубой тунец уходит на сотни метров, а белая акула и манта — глубже километра. Белую акулу мы показываем только здесь, в виртуальном спуске.',animals:named('tuna','shark','manta')},
 {range:'глубже 1000 м · полуночная зона',title:'Свет здесь делают сами животные',text:'Солнечного света нет совсем. Вспышки вокруг — биолюминесценция: многие глубоководные рыбы, кальмары и рачки светятся сами. Таких обитателей в «Пелагосе» нет, это виртуальная часть спуска.',animals:[]},
];
---
<Shell title="Глубина — спуск в океан" description="Виртуальный спуск от поверхности океана в темноту: какие обитатели живут на разной глубине." active="depth" home>
<div class="descent" data-descent>
 <div class="descent-stage" aria-hidden="true" data-overlap-ok><div class="descent-water"></div><DescentScene client:idle/><div class="descent-dark"></div><div class="descent-shade"></div>
  <div class="depth-gauge"><span data-depth-meters>0 м</span><i></i></div></div>
 <section class="descent-chapter descent-intro" data-descent-stop aria-labelledby="depth-title"><div class="descent-copy"><p class="eyebrow">Глубина · виртуальный спуск</p><h1 id="depth-title">Спуск от поверхности до темноты</h1><p class="lead">Прокручивайте страницу — и сцена опустится вместе с вами. С каждой сотней метров света меньше, а обитатели другие.</p></div>
  <div class="hero-bottom"><a class="scroll-hint" href="#sunlit"><Icon name="down"/><span>Начать<br/>спуск</span></a><button class="scene-pause" data-scene-pause aria-pressed="false"><span aria-hidden="true">Ⅱ</span><span data-motion-label>Остановить движение</span></button></div></section>
 {chapters.map((chapter,i)=><section class="descent-chapter" id={['sunlit','twilight','midnight'][i]} data-descent-stop><div class="descent-copy"><p class="eyebrow">{chapter.range}</p><h2>{chapter.title}</h2><p>{chapter.text}</p>{chapter.animals.length>0&&<ul class="descent-animals">{chapter.animals.map(animal=><li><a href={url(`inhabitants/${animal.slug}/`)}><span><strong>{animal.name}</strong><small>{animal.latin}</small></span><Icon/></a></li>)}</ul>}</div></section>)}
 <section class="descent-chapter descent-end"><div class="descent-copy"><p class="eyebrow">Конец спуска</p><h2>Каждого из них можно рассмотреть ближе</h2><p>В атласе — карточки обитателей с 3D-моделями: где живут, чем питаются и что заметить у стекла.</p><div class="descent-actions"><a class="action filled" href={url('inhabitants/')}>Открыть атлас <Icon/></a><a class="text-link" href="#main">Подняться к поверхности <Icon name="down" class="icon-up"/></a></div></div></section>
</div>
</Shell>
