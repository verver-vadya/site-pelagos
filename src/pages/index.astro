---
import Shell from '../layouts/Shell.astro';
import Icon from '../components/Icon.astro';
import DiveButton from '../components/DiveButton.astro';
import AquariumScene from '../components/AquariumScene';
import {species,zones,events} from '../data/ocean';
import {url} from '../lib/paths';
import '../styles/scene.css';
---
<Shell title="Океан ближе, чем кажется" home>
<section class="hero-aquarium" aria-labelledby="hero-title"><div class="aquarium-poster" style={`background-image:url(${url('media/backdrop-unlit.webp')})`} aria-hidden="true"></div><AquariumScene client:idle/><div class="hero-shade" aria-hidden="true"></div><div class="hero-copy"><p class="eyebrow">ПО ТУ СТОРОНУ СТЕКЛА</p><h1 id="hero-title">Океан ближе,<br/>чем кажется.</h1><div class="hero-action-row"><p class="hero-description">Целый мир — на расстоянии взгляда.<br/> Познакомьтесь с ним в «Пелагосе».</p><DiveButton href={url('depth/')}/></div></div>
<a class="observation-tag" href={url('inhabitants/manta/')}><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M7 17V7h10m14 0h10v10m0 14v10H31m-14 0H7V31"/><circle cx="24" cy="24" r="5"/><path d="M24 15v-3m0 24v-3m-9-9h-3m24 0h-3"/></svg><span><small>НАБЛЮДЕНИЕ 01</small><strong>Океаническая манта</strong><span class="observe-link">Рассмотреть поближе ↗</span></span></a>
<div class="hero-bottom"><a class="scroll-hint" href="#encounters"><Icon name="down"/><span>Прокрутите,<br/>чтобы узнать больше</span></a><nav class="chapter-scale" aria-label="Продолжение путешествия"><a href={url('depth/')}><span>01</span>Глубина</a><i aria-hidden="true"></i><a href={url('inhabitants/')}><span>02</span>Встречи</a><i aria-hidden="true"></i><a href={url('map/')}><span>03</span>Маршрут</a></nav><button class="scene-pause" data-scene-pause aria-pressed="false"><span aria-hidden="true">Ⅱ</span><span data-motion-label>Остановить движение</span></button></div></section>
<section class="section" id="encounters"><div class="section-top"><div><p class="eyebrow">АТЛАС / ВСТРЕЧИ</p><h2>Разглядеть.<br/>А потом узнать.</h2></div><p>У каждого силуэта своя среда, привычки и способ двигаться. Выберите, с кем познакомиться первым.</p></div><div class="encounter-layout"><a class="encounter-feature" href={url('inhabitants/manta/')}><img src={url('media/species/manta.webp')} alt="Океаническая манта — 3D-наблюдение" width="600" height="440" loading="lazy"/><h3>Полёт, которому не нужен воздух.</h3><span class="text-link">Знакомство с мантой <Icon/></span></a><div class="encounter-list">{['turtle','jelly','octopus','seahorse'].map((slug,i)=>{const animal=species.find(item=>item.slug===slug)!;return <a href={url(`inhabitants/${slug}/`)}><span>{String(i+2).padStart(2,'0')}</span><span><strong>{animal.name}</strong><small>{animal.latin}</small></span><Icon/></a>;})}<a class="text-link" href={url('inhabitants/')}>Все обитатели атласа <Icon/></a></div></div></section>
<section class="section" style="border-top:1px solid var(--line)"><div class="section-top"><div><p class="eyebrow">ПРОГУЛКА / ВЫБИРАЕТЕ ВЫ</p><h2>Четыре зала.<br/>Ваш собственный путь.</h2></div><a class="action" href={url('map/')}>Собрать маршрут <Icon/></a></div><div class="route-teaser">{zones.map(zone=><a href={url(`map/?zone=${zone.id}`)}><span class="station">{zone.number}</span><h3>{zone.name}</h3><p>{zone.short}</p></a>)}</div></section>
<section class="section program-preview"><div class="section-top"><div><p class="eyebrow">ПРОГРАММА / ЕЩЁ ОДНА ИСТОРИЯ</p><h2>Задержитесь<br/>на разговор.</h2></div><a class="text-link" href={url('schedule/')}>Вся программа <Icon/></a></div><p class="concept-line" style="margin-bottom:32px">Программа встреч создана для концепта. Это не расписание действующей площадки.</p>{events.slice(0,3).map(event=><article class="table-row"><time>{event.time}</time><div><h3>{event.title}</h3><p>{event.description}</p><p class="event-meta">{event.duration}</p></div><a class="text-link" href={url('schedule/')}>Выбрать встречу <Icon/></a></article>)}</section>
<section class="section diary-invite"><div class="diary-circle" aria-hidden="true"><span><strong>01</strong>ВАШЕ ПЕРВОЕ<br/>ОТКРЫТИЕ</span></div><div><p class="eyebrow">ДНЕВНИК ИССЛЕДОВАТЕЛЯ</p><h2>Соберите свои<br/>встречи с океаном.</h2><p>Отмечайте обитателей, которых рассмотрели в атласе. Вернитесь к ним позже или продолжите исследование вместе.</p><a class="action filled" href={url('journal/')}>Открыть дневник <Icon/></a></div></section>
</Shell>
